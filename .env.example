# Postgres (Neon, Supabase, local…)
DATABASE_URL=postgres://user:password@localhost:5432/kairos

# URL du service FastAPI + Playwright (scraper/)
PYTHON_SCRAPER_URL=http://localhost:8000

# Fallback IA quand le parser DOM échoue
GEMINI_API_KEY=
# Optionnels, défauts : gemini-3.5-flash puis gemini-3.5-flash-lite si surcharge
GEMINI_MODEL=
GEMINI_BACKUP_MODEL=

# Emails d'alerte
RESEND_API_KEY=
# Optionnel, défaut : Kairos <onboarding@resend.dev>
MAIL_FROM=

# Secret partagé avec Vercel Cron (header Authorization: Bearer …)
CRON_SECRET=
